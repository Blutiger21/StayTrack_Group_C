@model StayTrack.Models.ViewModels.RecordPaymentViewModel
@{
    ViewData["Title"] = "Record Payment";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Payments
                </a>
                <h2 class="fw-bold mb-0 text-dark">Record Rent Payment</h2>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6">
                <i class="bi bi-plus-circle-fill me-1"></i> Management Direct
            </span>
        </div>

        <div class="card card-custom p-4 shadow-sm">
            <div class="card-body p-0">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <form asp-action="Record" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TenantId" />

                    <!-- Step 1: Payment Reference Lookup -->
                    <div class="mb-4">
                        <label asp-for="PaymentReference" class="form-label fw-semibold text-secondary small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light font-monospace">#</span>
                            <input asp-for="PaymentReference" class="form-control font-monospace fs-5 @(ViewData.ModelState["PaymentReference"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                   placeholder="e.g. STAY-1001" autofocus />
                            <button type="submit" name="action" value="lookup" class="btn btn-outline-primary px-3">
                                <i class="bi bi-search me-1"></i> Lookup Tenant
                            </button>
                        </div>
                        <span asp-validation-for="PaymentReference" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text small">Enter the student's unique payment reference and click Lookup to confirm their record.</div>
                    </div>

                    <!-- Step 2: Matched Tenant Confirmation Banner -->
                    @if (Model.TenantConfirmed && Model.MatchedTenant != null)
                    {
                        var tenant = Model.MatchedTenant;
                        <div class="alert alert-success border-success-subtle p-3 mb-4 rounded-3 shadow-sm" role="alert">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-check-circle-fill text-success fs-3 flex-shrink-0 mt-1"></i>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h5 class="fw-bold text-dark mb-0">@(tenant.Profile?.FullName ?? "Tenant #" + tenant.TenantId)</h5>
                                        <span class="badge bg-success">Confirmed Match</span>
                                    </div>
                                    <div class="text-muted small">
                                        Student #: <strong class="text-dark font-monospace">@tenant.StudentNumber</strong> &bull;
                                        Property: <strong class="text-dark">@(tenant.Room?.Property?.Name ?? "-")</strong> &bull;
                                        Room: <strong class="text-dark">@(tenant.Room?.RoomNumber ?? "-")</strong>
                                    </div>
                                    <div class="mt-2 text-dark small">
                                        Standard Monthly Rent: <strong class="text-primary font-monospace fs-6">R @tenant.RentalAmount.ToString("N2")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Transaction Details -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">R</span>
                                    <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PaymentDate" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="PaymentDate" type="date" class="form-control" />
                                <span asp-validation-for="PaymentDate" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="PeriodMonth" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="PeriodMonth" type="date" class="form-control" />
                                <span asp-validation-for="PeriodMonth" class="text-danger small mt-1 d-block"></span>
                                <div class="form-text small">Select the month this payment covers.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CustomReference" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="CustomReference" class="form-control" placeholder="e.g. Bank EFT #12345 or Cash receipt" />
                                <span asp-validation-for="CustomReference" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 small text-muted mb-4 border">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            This payment will be saved with status <strong>Approved</strong> and verified by your manager account timestamped immediately.
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" name="action" value="save" class="btn btn-primary px-4">
                                <i class="bi bi-check2-circle me-1"></i> Record &amp; Approve Payment
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border text-muted small p-3">
                            <i class="bi bi-info-circle me-1 text-primary"></i>
                            After looking up the payment reference, the student's name, room number, and agreed monthly rental amount will be displayed to confirm the lease before saving.
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

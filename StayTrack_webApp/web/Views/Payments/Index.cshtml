@model StayTrack.Models.ViewModels.PaymentListViewModel
@{
    ViewData["Title"] = "Rent Payments";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Rent Payments</h2>
        <p class="text-muted mb-0">Inspect proof of payments, verify submissions, and record manual rental transactions.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Record" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Record Payment</span>
        </a>
    </div>
</div>

<!-- Status Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "all" ? "active" : "")" 
           asp-action="Index" asp-route-tab="all" asp-route-search="@Model.SearchQuery">
            All Payments
            <span class="badge @(Model.ActiveTab == "all" ? "bg-light text-primary" : "bg-secondary text-white") ms-1">
                @Model.AllCount
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "pending" ? "active" : "")" 
           asp-action="Index" asp-route-tab="pending" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-hourglass-split me-1"></i> Pending
            <span class="badge @(Model.ActiveTab == "pending" ? "bg-light text-primary" : "bg-warning text-dark") ms-1">
                @Model.PendingCount
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "approved" ? "active" : "")" 
           asp-action="Index" asp-route-tab="approved" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-check2-circle me-1"></i> Approved
            <span class="badge @(Model.ActiveTab == "approved" ? "bg-light text-primary" : "bg-success text-white") ms-1">
                @Model.ApprovedCount
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "rejected" ? "active" : "")" 
           asp-action="Index" asp-route-tab="rejected" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-x-circle me-1"></i> Rejected
            <span class="badge @(Model.ActiveTab == "rejected" ? "bg-light text-primary" : "bg-danger text-white") ms-1">
                @Model.RejectedCount
            </span>
        </a>
    </li>
</ul>

<!-- Search Bar -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        <div class="col-md-9 col-lg-10">
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchQuery" 
                       class="form-control border-start-0" 
                       placeholder="Search by student name, student number, reference, or room..." />
            </div>
        </div>
        <div class="col-md-3 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Index" asp-route-tab="@Model.ActiveTab" class="btn btn-outline-secondary" title="Clear filter">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Payments Table -->
@if (!Model.Payments.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-credit-card-2-front"></i>
        </div>
        <h5 class="fw-bold">No Payments Found</h5>
        <p class="text-muted small mb-3">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery) 
                ? $"There are currently no {Model.ActiveTab} payments recorded in the system." 
                : $"No payments matched your search query '{Model.SearchQuery}'.")
        </p>
        <a asp-action="Record" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Record a Payment
        </a>
    </div>
}
else
{
    <div class="card card-custom overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-3 py-3">Tenant</th>
                        <th>Month Paid</th>
                        <th>Amount</th>
                        <th>Payment Date</th>
                        <th>Reference</th>
                        <th>Proof</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-semibold text-dark">
                                    @(payment.Tenant?.Profile?.FullName ?? "Tenant #" + payment.TenantId)
                                </div>
                                <div class="small text-muted">
                                    @(payment.Tenant?.Room?.Property?.Name ?? "Property") &bull; Room @(payment.Tenant?.Room?.RoomNumber ?? "-")
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">
                                    @payment.PeriodMonth.ToString("MMMM yyyy")
                                </span>
                            </td>
                            <td>
                                <strong class="fs-6 text-dark">R @payment.Amount.ToString("N2")</strong>
                            </td>
                            <td class="small">
                                <i class="bi bi-calendar-event me-1 text-muted"></i>
                                @payment.PaymentDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">
                                    @payment.Reference
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(payment.ProofUrl))
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        <i class="bi bi-paperclip me-1"></i> Receipt
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Manual Record</span>
                                }
                            </td>
                            <td>
                                @if (payment.Status == "approved")
                                {
                                    <span class="badge-status badge-approved">Approved</span>
                                }
                                else if (payment.Status == "rejected")
                                {
                                    <span class="badge-status badge-rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-pending">Pending</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@payment.PaymentId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye-fill me-1"></i> View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

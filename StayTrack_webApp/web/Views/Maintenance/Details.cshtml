@model StayTrack.Models.ViewModels.MaintenanceDetailViewModel
@{
    ViewData["Title"] = $"Maintenance Ticket #{Model.Request.RequestId}";
    var req = Model.Request;
}

<div class="row justify-content-center py-3">
    <div class="col-lg-11">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Maintenance
                </a>
                <h2 class="fw-bold mb-0 text-dark">@req.Title</h2>
            </div>
            <div>
                @if (req.Status == "completed")
                {
                    <span class="badge-status badge-completed fs-6 px-3 py-2">
                        <i class="bi bi-check2-all me-1"></i> Completed
                    </span>
                }
                else if (req.Status == "assigned")
                {
                    <span class="badge-status badge-assigned fs-6 px-3 py-2">
                        <i class="bi bi-person-check-fill me-1"></i> Assigned
                    </span>
                }
                else
                {
                    <span class="badge-status badge-pending fs-6 px-3 py-2">
                        <i class="bi bi-hourglass-split me-1"></i> Pending Assignment
                    </span>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Details and Management Controls -->
            <div class="col-lg-6">
                <!-- Location & Tenant Card -->
                <div class="card card-custom p-4 mb-3">
                    <h6 class="text-secondary small fw-semibold text-uppercase mb-3">Location &amp; Tenant</h6>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-geo-alt-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@(req.Tenant?.Room?.Property?.Name ?? "Property")</h5>
                            <div class="text-muted small">
                                Room: <strong class="text-dark">@(req.Tenant?.Room?.RoomNumber ?? "-")</strong> (@(req.Tenant?.Room?.RoomType ?? "-"))
                            </div>
                        </div>
                    </div>
                    <div class="border-top pt-2 small text-muted">
                        <div>Reported By: <strong>@(req.Tenant?.Profile?.FullName ?? "Tenant #" + req.TenantId)</strong></div>
                        <div>Student Number: <span class="font-monospace">@(req.Tenant?.StudentNumber ?? "-")</span></div>
                        <div>Submitted: @req.DateSubmitted.ToString("MMMM dd, yyyy HH:mm")</div>
                        @if (req.DateCompleted.HasValue)
                        {
                            <div class="text-success"><i class="bi bi-check-circle me-1"></i> Completed: @req.DateCompleted.Value.ToString("MMMM dd, yyyy HH:mm")</div>
                        }
                    </div>
                </div>

                <!-- Description Card -->
                <div class="card card-custom p-4 mb-3">
                    <h6 class="text-secondary small fw-semibold text-uppercase mb-2">Issue Description</h6>
                    <p class="text-dark mb-0" style="white-space: pre-wrap;">@req.Description</p>
                </div>

                <!-- Technician Assignment Card -->
                <div class="card card-custom p-4 mb-3">
                    <h6 class="text-secondary small fw-semibold text-uppercase mb-3">Assign Technician</h6>
                    <form asp-action="AssignTechnician" asp-route-id="@req.RequestId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Choose Maintenance Technician</label>
                            <select name="technicianId" class="form-select" required>
                                <option value="">-- Select Technician --</option>
                                @foreach (var tech in Model.AvailableTechnicians)
                                {
                                    <option value="@tech.TechnicianId" selected="@(tech.TechnicianId == req.TechnicianId)">
                                        @(tech.Profile?.FullName ?? "Technician #" + tech.TechnicianId) (@(tech.Profile?.Email ?? "No email"))
                                    </option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-person-check-fill"></i>
                            <span>Assign Technician (Set Status to 'Assigned')</span>
                        </button>
                    </form>
                </div>

                <!-- Status Workflow Card -->
                <div class="card card-custom p-4">
                    <h6 class="text-secondary small fw-semibold text-uppercase mb-3">Status Controls</h6>
                    <div class="d-flex gap-2">
                        @if (req.Status != "pending")
                        {
                            <form asp-action="UpdateStatus" asp-route-id="@req.RequestId" method="post" class="flex-grow-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="pending" />
                                <button type="submit" class="btn btn-outline-warning w-100 py-2"
                                        onclick="return confirm('Revert ticket status back to Pending?');">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Set to Pending
                                </button>
                            </form>
                        }

                        @if (req.Status != "completed")
                        {
                            <form asp-action="UpdateStatus" asp-route-id="@req.RequestId" method="post" class="flex-grow-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="completed" />
                                <button type="submit" class="btn btn-success w-100 py-2"
                                        onclick="return confirm('Mark this maintenance ticket as Completed?');">
                                    <i class="bi bi-check2-circle me-1"></i> Set to Completed
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Maintenance Photo Viewer -->
            <div class="col-lg-6">
                <div class="card card-custom h-100 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-secondary small fw-semibold text-uppercase mb-0">Attached Photo</h6>
                        @if (Model.HasPhoto)
                        {
                            <a href="@Model.SignedPhotoUrl" target="_blank" rel="noopener noreferrer" 
                               class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-box-arrow-up-right"></i> Open Full View
                            </a>
                        }
                    </div>

                    @if (!Model.HasPhoto)
                    {
                        <div class="empty-state my-auto">
                            <div class="empty-state-icon">
                                <i class="bi bi-camera-slash"></i>
                            </div>
                            <h5 class="fw-bold">No Photo Attached</h5>
                            <p class="text-muted small mb-0">The resident did not attach an issue photo with this ticket.</p>
                        </div>
                    }
                    else
                    {
                        <div class="border rounded-3 p-2 bg-light text-center h-100 d-flex flex-column justify-content-center overflow-auto">
                            <img src="@Model.SignedPhotoUrl" alt="Maintenance Issue Photo" 
                                 class="img-fluid rounded shadow-sm mx-auto" 
                                 style="max-height: 600px; object-fit: contain;" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

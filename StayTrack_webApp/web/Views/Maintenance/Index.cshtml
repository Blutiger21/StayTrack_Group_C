@model StayTrack.Models.ViewModels.MaintenanceListViewModel
@{
    ViewData["Title"] = "Maintenance Requests";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Maintenance Requests</h2>
        <p class="text-muted mb-0">Oversee student accommodation repair tickets, assign technicians, and track progress.</p>
    </div>
</div>

<!-- Status Filters -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "all" ? "active" : "")" 
           asp-action="Index" asp-route-filter="all" asp-route-search="@Model.SearchQuery">
            All Tickets
            <span class="badge @(Model.StatusFilter == "all" ? "bg-light text-primary" : "bg-secondary text-white") ms-1">
                @Model.TotalCount
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "pending" ? "active" : "")" 
           asp-action="Index" asp-route-filter="pending" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-hourglass-split me-1"></i> Pending
            <span class="badge @(Model.StatusFilter == "pending" ? "bg-light text-primary" : "bg-warning text-dark") ms-1">
                @Model.PendingCount
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "assigned" ? "active" : "")" 
           asp-action="Index" asp-route-filter="assigned" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-person-check-fill me-1"></i> Assigned
            <span class="badge @(Model.StatusFilter == "assigned" ? "bg-light text-primary" : "bg-info text-dark") ms-1">
                @Model.AssignedCount
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "completed" ? "active" : "")" 
           asp-action="Index" asp-route-filter="completed" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-check2-all me-1"></i> Completed
            <span class="badge @(Model.StatusFilter == "completed" ? "bg-light text-primary" : "bg-success text-white") ms-1">
                @Model.CompletedCount
            </span>
        </a>
    </li>
</ul>

<!-- Search Bar -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <input type="hidden" name="filter" value="@Model.StatusFilter" />
        <div class="col-md-9 col-lg-10">
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchQuery" 
                       class="form-control border-start-0" 
                       placeholder="Search by issue title, description, tenant name, room, or technician..." />
            </div>
        </div>
        <div class="col-md-3 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Index" asp-route-filter="@Model.StatusFilter" class="btn btn-outline-secondary" title="Clear filter">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Requests Table -->
@if (!Model.Requests.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-tools"></i>
        </div>
        <h5 class="fw-bold">No Maintenance Requests Found</h5>
        <p class="text-muted small mb-0">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery) 
                ? $"There are currently no {Model.StatusFilter} maintenance tickets in the system." 
                : $"No tickets matched your search query '{Model.SearchQuery}'.")
        </p>
    </div>
}
else
{
    <div class="card card-custom overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-3 py-3">Issue Title</th>
                        <th>Tenant &amp; Location</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Assigned Technician</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.Requests)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark mb-0">@req.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 280px;">
                                    @req.Description
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @(req.Tenant?.Profile?.FullName ?? "Tenant #" + req.TenantId)
                                </div>
                                <div class="small text-muted">
                                    @(req.Tenant?.Room?.Property?.Name ?? "Property") &bull; Room @(req.Tenant?.Room?.RoomNumber ?? "-")
                                </div>
                            </td>
                            <td class="small">
                                <i class="bi bi-calendar3 me-1 text-muted"></i>
                                @req.DateSubmitted.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (req.Status == "completed")
                                {
                                    <span class="badge-status badge-completed">Completed</span>
                                }
                                else if (req.Status == "assigned")
                                {
                                    <span class="badge-status badge-assigned">Assigned</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-pending">Pending</span>
                                }
                            </td>
                            <td>
                                @if (req.Technician?.Profile != null)
                                {
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-wrench text-secondary small"></i>
                                        <span class="fw-semibold text-dark small">@req.Technician.Profile.FullName</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary small">Unassigned</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@req.RequestId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-sliders me-1"></i> Manage
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

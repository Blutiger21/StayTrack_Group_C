@using StayTrack.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayTrack Accommodation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-staytrack py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded p-1" style="width: 32px; height: 32px;">
                        <i class="bi bi-buildings-fill fs-5"></i>
                    </span>
                    <span class="fs-5 fw-bold text-dark">StayTrack</span>
                    <span class="badge bg-light text-secondary border rounded-pill ms-1 fw-normal" style="font-size: 0.7rem;">Portal</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(AppRoles.Management))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                                       asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tenants" ? "active" : "")" 
                                       asp-controller="Tenants" asp-action="Index">
                                        <i class="bi bi-people-fill me-1"></i> Tenants
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")" 
                                       asp-controller="Payments" asp-action="Index">
                                        <i class="bi bi-credit-card-2-front-fill me-1"></i> Payments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" 
                                       asp-controller="Reports" asp-action="Monthly">
                                        <i class="bi bi-file-earmark-bar-graph-fill me-1"></i> Monthly Report
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")" 
                                       asp-controller="Maintenance" asp-action="Index">
                                        <i class="bi bi-tools me-1"></i> Maintenance
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcements" ? "active" : "")" 
                                       asp-controller="Announcements" asp-action="Index">
                                        <i class="bi bi-megaphone-fill me-1"></i> Announcements
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(AppRoles.Technician))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Technician" ? "active" : "")" 
                                       asp-controller="Technician" asp-action="Index">
                                        <i class="bi bi-wrench-adjustable-circle-fill me-1"></i> My Assigned Requests
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="d-flex align-items-center bg-light border rounded px-3 py-1 me-1">
                                <i class="bi bi-person-circle text-secondary me-2"></i>
                                <div class="text-start lh-sm">
                                    <div class="fw-semibold small text-dark">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User")</div>
                                    <span class="badge @(User.IsInRole(AppRoles.Management) ? "bg-primary" : "bg-info text-dark")" style="font-size: 0.65rem;">
                                        @(User.IsInRole(AppRoles.Management) ? "MANAGEMENT" : (User.IsInRole(AppRoles.Technician) ? "TECHNICIAN" : "STUDENT"))
                                    </span>
                                </div>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 d-flex align-items-center gap-1">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Sign Out</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm px-3 d-flex align-items-center gap-1" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Sign In</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="py-4">
        <div class="container-fluid px-lg-4">
            <!-- Global Flash Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-5"></i>
                    <div>@TempData["Warning"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>@TempData["Info"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="py-3 mt-auto">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                <strong>StayTrack</strong> &bull; Student Accommodation Payment &amp; Maintenance Portal
            </div>
            <div class="text-muted small">
                Connected to Supabase RLS &bull; Built with ASP.NET Core MVC &amp; Bootstrap
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

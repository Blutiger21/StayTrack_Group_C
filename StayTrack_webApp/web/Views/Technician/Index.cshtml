@model List<StayTrack.Models.Entities.MaintenanceRequest>
@{
    ViewData["Title"] = "My Assigned Requests";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Assigned Maintenance Tasks</h2>
        <p class="text-muted mb-0">Repair requests assigned to you for inspection and resolution.</p>
    </div>
    <span class="badge bg-info-subtle text-dark border border-info-subtle px-3 py-2 rounded-pill fs-6">
        <i class="bi bi-wrench-adjustable-circle-fill me-1"></i> Technician Portal
    </span>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-check-circle"></i>
        </div>
        <h5 class="fw-bold">No Active Tasks Assigned</h5>
        <p class="text-muted small mb-0">
            You currently have no repair tickets assigned to your account. New tasks assigned by management will appear here.
        </p>
    </div>
}
else
{
    <div class="card card-custom overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-3 py-3">Task Title</th>
                        <th>Date Submitted</th>
                        <th>Status</th>
                        <th>Completed Date</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">@req.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 380px;">
                                    @req.Description
                                </div>
                            </td>
                            <td class="small">
                                <i class="bi bi-calendar-event me-1 text-muted"></i>
                                @req.DateSubmitted.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (req.Status == "completed")
                                {
                                    <span class="badge-status badge-completed">
                                        <i class="bi bi-check2-all me-1"></i> Completed
                                    </span>
                                }
                                else if (req.Status == "assigned")
                                {
                                    <span class="badge-status badge-assigned">
                                        <i class="bi bi-tools me-1"></i> In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-pending">Pending</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(req.DateCompleted.HasValue ? req.DateCompleted.Value.ToString("MMM dd, yyyy HH:mm") : "-")
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@req.RequestId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i> View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

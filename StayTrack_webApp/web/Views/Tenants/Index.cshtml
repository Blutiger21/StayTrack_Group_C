@model StayTrack.Models.ViewModels.TenantListViewModel
@{
    ViewData["Title"] = "Tenant Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Tenant &amp; Accommodation Management</h2>
        <p class="text-muted mb-0">Manage registered student tenants, room allocations, and residences.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add Tenant</span>
        </a>
    </div>
</div>

<!-- Tabs: Tenants vs Properties & Rooms -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab != "rooms" ? "active" : "")" 
           asp-action="Index" asp-route-tab="tenants" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-people-fill me-1"></i> Student Tenants
            <span class="badge @(Model.ActiveTab != "rooms" ? "bg-light text-primary" : "bg-secondary text-white") ms-1">
                @Model.Tenants.Count
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "rooms" ? "active" : "")" 
           asp-action="Index" asp-route-tab="rooms" asp-route-search="@Model.SearchQuery">
            <i class="bi bi-buildings-fill me-1"></i> Properties &amp; Rooms
            <span class="badge @(Model.ActiveTab == "rooms" ? "bg-light text-primary" : "bg-secondary text-white") ms-1">
                @Model.Rooms.Count
            </span>
        </a>
    </li>
</ul>

@if (Model.ActiveTab != "rooms")
{
    <!-- Search Bar -->
    <div class="card card-custom p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" name="tab" value="tenants" />
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@Model.SearchQuery" 
                           class="form-control border-start-0" 
                           placeholder="Search by student name, student number, room, or payment reference..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    Search
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a asp-action="Index" asp-route-tab="tenants" class="btn btn-outline-secondary" title="Clear filter">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Tenants Table -->
    @if (!Model.Tenants.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="fw-bold">No Tenants Found</h5>
            <p class="text-muted small mb-3">
                @(string.IsNullOrWhiteSpace(Model.SearchQuery) 
                    ? "There are currently no registered tenant leases in the system." 
                    : $"No tenants matched your search query '{Model.SearchQuery}'.")
            </p>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add First Tenant
            </a>
        </div>
    }
    else
    {
        <div class="card card-custom overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3 py-3">Student Name</th>
                            <th>Student #</th>
                            <th>Property &amp; Room</th>
                            <th>Payment Ref</th>
                            <th>Monthly Rent</th>
                            <th>Lease Period</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in Model.Tenants)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold text-dark">
                                        @(tenant.Profile?.FullName ?? "Unknown Student")
                                    </div>
                                    <div class="small text-muted">
                                        @(tenant.Profile?.Email ?? "-")
                                        @if (!string.IsNullOrWhiteSpace(tenant.Profile?.Phone))
                                        {
                                            <span> &bull; @tenant.Profile.Phone</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">
                                        @tenant.StudentNumber
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        @(tenant.Room?.Property?.Name ?? "Property")
                                    </div>
                                    <div class="small text-muted">
                                        Room <strong>@(tenant.Room?.RoomNumber ?? tenant.RoomId.ToString())</strong>
                                        @if (!string.IsNullOrWhiteSpace(tenant.Room?.RoomType))
                                        {
                                            <span>(@tenant.Room.RoomType)</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fs-6">
                                        @tenant.PaymentReference
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-dark">R @tenant.RentalAmount.ToString("N2")</strong>
                                </td>
                                <td class="small">
                                    <div class="text-nowrap">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                                        @tenant.LeaseStart.ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="text-muted text-nowrap">
                                        to @tenant.LeaseEnd.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td>
                                    @if (tenant.Status == "active")
                                    {
                                        <span class="badge-status badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-3 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@tenant.TenantId" 
                                       class="btn btn-outline-secondary btn-sm me-1" title="Edit lease">
                                        <i class="bi bi-pencil-fill"></i> Edit
                                    </a>
                                    @if (tenant.Status == "active")
                                    {
                                        <form asp-action="Archive" asp-route-id="@tenant.TenantId" method="post" 
                                              class="d-inline" onsubmit="return confirm('Archive this tenant lease? The status will be set to inactive and the room will be marked vacant.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Archive tenant">
                                                <i class="bi bi-archive-fill"></i> Archive
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <!-- Properties & Rooms Tab -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Residences &amp; Rooms Overview</h5>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPropertyModal">
                <i class="bi bi-building-add me-1"></i> Add Property
            </button>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addRoomModal"
                    @(Model.Properties.Any() ? "" : "disabled")>
                <i class="bi bi-plus-circle me-1"></i> Add Room
            </button>
        </div>
    </div>

    @if (!Model.Properties.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-buildings"></i>
            </div>
            <h5 class="fw-bold">No Properties Created Yet</h5>
            <p class="text-muted small mb-3">Add your student accommodation buildings or residence properties first.</p>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPropertyModal">
                <i class="bi bi-building-add me-1"></i> Add First Property
            </button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var property in Model.Properties)
            {
                var propRooms = Model.Rooms.Where(r => r.PropertyId == property.PropertyId).ToList();
                var vacantCount = propRooms.Count(r => r.Status == "vacant");
                var occupiedCount = propRooms.Count(r => r.Status == "occupied");

                <div class="col-lg-6">
                    <div class="card card-custom h-100">
                        <div class="card-header-clean d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <i class="bi bi-building text-primary me-2"></i>@property.Name
                                </h5>
                                <div class="text-muted small">
                                    <i class="bi bi-geo-alt me-1"></i>@property.Address
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border">@propRooms.Count Rooms</span>
                                <div class="small mt-1">
                                    <span class="badge-status badge-vacant me-1">@vacantCount Vacant</span>
                                    <span class="badge-status badge-occupied">@occupiedCount Occupied</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            @if (!propRooms.Any())
                            {
                                <div class="p-3 text-center text-muted small bg-light rounded-3">
                                    No rooms added to this property yet.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0 align-middle">
                                        <thead class="text-muted small">
                                            <tr>
                                                <th>Room #</th>
                                                <th>Type</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var room in propRooms)
                                            {
                                                <tr>
                                                    <td class="fw-bold font-monospace">@room.RoomNumber</td>
                                                    <td>@room.RoomType</td>
                                                    <td>
                                                        @if (room.Status == "occupied")
                                                        {
                                                            <span class="badge-status badge-occupied">Occupied</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-status badge-vacant">Vacant</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Add Room Modal -->
    <div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="CreateRoom" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="addRoomModalLabel">Add New Room</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Property / Residence</label>
                            <select name="PropertyId" class="form-select" required>
                                <option value="">-- Choose Property --</option>
                                @foreach (var p in Model.Properties)
                                {
                                    <option value="@p.PropertyId">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Room Number</label>
                            <input type="text" name="RoomNumber" class="form-control" placeholder="e.g. 101, A2, 204B" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Room Type</label>
                            <select name="RoomType" class="form-select">
                                <option value="Single Room">Single Room</option>
                                <option value="Double Sharing">Double Sharing</option>
                                <option value="En-Suite Single">En-Suite Single</option>
                                <option value="Studio Apartment">Studio Apartment</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Status</label>
                            <select name="Status" class="form-select">
                                <option value="vacant">Vacant</option>
                                <option value="occupied">Occupied</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Room</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Property Modal -->
    <div class="modal fade" id="addPropertyModal" tabindex="-1" aria-labelledby="addPropertyModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="CreateProperty" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="addPropertyModalLabel">Add New Property</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Property Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. South Campus Village" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Physical Address</label>
                            <input type="text" name="Address" class="form-control" placeholder="e.g. 12 University Way, Hatfield" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Property</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

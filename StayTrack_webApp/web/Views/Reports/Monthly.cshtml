@model StayTrack.Models.ViewModels.MonthlyReportViewModel
@{
    ViewData["Title"] = $"Monthly Report - {Model.MonthDisplayName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Monthly Rent Collection Report</h2>
        <p class="text-muted mb-0">Live reconciliation of tenant rental payments for <strong>@Model.MonthDisplayName</strong>.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <!-- Month Picker Form -->
        <form method="get" asp-action="Monthly" class="d-flex align-items-center gap-2">
            <input type="month" name="month" value="@Model.MonthString" class="form-control" onchange="this.form.submit()" />
        </form>

        <!-- CSV Export Button -->
        <a asp-action="ExportCsv" asp-route-month="@Model.MonthString" 
           class="btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
            <span>Download CSV</span>
        </a>
    </div>
</div>

<!-- Key Performance Metrics -->
<div class="row g-3 mb-4">
    <!-- Paid Tenants -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Paid Tenants</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.PaidCount <span class="fs-6 text-muted fw-normal">/ @Model.TotalTenants</span></h3>
                </div>
                <div class="bg-success-subtle text-success p-2 rounded-3">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                @(Model.TotalTenants > 0 ? $"{(Model.PaidCount * 100.0 / Model.TotalTenants):F0}% fully paid" : "No active tenants")
            </div>
        </div>
    </div>

    <!-- Unpaid Tenants -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Unpaid Tenants</div>
                    <h3 class="fw-bold mb-0 text-danger">@Model.UnpaidCount</h3>
                </div>
                <div class="bg-danger-subtle text-danger p-2 rounded-3">
                    <i class="bi bi-x-octagon-fill fs-3"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                @if (Model.PendingCount > 0)
                {
                    <span class="text-warning fw-semibold">+ @Model.PendingCount pending review</span>
                }
                else
                {
                    <span>Zero approved payments</span>
                }
            </div>
        </div>
    </div>

    <!-- Total Collected -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Collected</div>
                    <h3 class="fw-bold mb-0 text-primary">R @Model.TotalCollected.ToString("N2")</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                Total approved rent payments
            </div>
        </div>
    </div>

    <!-- Outstanding Balance -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Outstanding Rent</div>
                    <h3 class="fw-bold mb-0 text-dark">R @Model.TotalOutstanding.ToString("N2")</h3>
                </div>
                <div class="bg-warning-subtle text-warning p-2 rounded-3">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                Expected: R @Model.TotalExpected.ToString("N2")
            </div>
        </div>
    </div>
</div>

<!-- Active Tenants Breakdown -->
@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-clipboard-data"></i>
        </div>
        <h5 class="fw-bold">No Active Tenants Found</h5>
        <p class="text-muted small mb-3">
            There are currently no active student tenant leases registered in the system.
        </p>
        <a asp-controller="Tenants" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Register a Tenant
        </a>
    </div>
}
else
{
    <div class="card card-custom overflow-hidden shadow-sm">
        <div class="card-header-clean d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                Tenant Reconciliation for @Model.MonthDisplayName
            </span>
            <span class="badge bg-light text-muted border">
                @Model.Items.Count Active Leases
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-3 py-3">Student Name</th>
                        <th>Student #</th>
                        <th>Residence &amp; Room</th>
                        <th>Payment Ref</th>
                        <th>Monthly Rent</th>
                        <th>Approved Paid</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-semibold text-dark">@item.StudentName</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">
                                    @item.StudentNumber
                                </span>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@item.PropertyName</div>
                                <div class="small text-muted">Room @item.RoomNumber</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border font-monospace">
                                    @item.PaymentReference
                                </span>
                            </td>
                            <td>
                                <span class="text-dark fw-medium">R @item.RentalAmount.ToString("N2")</span>
                            </td>
                            <td>
                                @if (item.ApprovedAmount > 0)
                                {
                                    <strong class="text-success font-monospace">R @item.ApprovedAmount.ToString("N2")</strong>
                                }
                                else if (item.PendingAmount > 0)
                                {
                                    <span class="text-warning font-monospace">R @item.PendingAmount.ToString("N2") (pending)</span>
                                }
                                else
                                {
                                    <span class="text-muted font-monospace">R 0.00</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Paid")
                                {
                                    <span class="badge-status badge-approved">
                                        <i class="bi bi-check-circle-fill me-1"></i> Paid
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge-status badge-pending">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-rejected">
                                        <i class="bi bi-x-circle-fill me-1"></i> Unpaid
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3 text-nowrap">
                                <a asp-controller="Payments" asp-action="Record" asp-route-reference="@item.PaymentReference" 
                                   class="btn btn-outline-primary btn-sm" title="Record payment for this tenant">
                                    <i class="bi bi-credit-card me-1"></i> Pay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

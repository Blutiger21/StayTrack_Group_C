@model StayTrack.Models.ViewModels.AnnouncementsPageViewModel
@{
    ViewData["Title"] = "Post Announcement";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Accommodation Announcements</h2>
        <p class="text-muted mb-0">Broadcast messages and notices to residents and staff across residences.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Post New Announcement Form -->
    <div class="col-lg-5">
        <div class="card card-custom p-4 shadow-sm sticky-top" style="top: 1.5rem;">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-megaphone-fill fs-5"></i>
                </span>
                <h5 class="fw-bold mb-0 text-dark">Post New Notice</h5>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Form.Title" class="form-label fw-semibold text-secondary small"></label>
                    <input asp-for="Form.Title" class="form-control" placeholder="e.g. Water Maintenance Notice - Block B" />
                    <span asp-validation-for="Form.Title" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Form.Message" class="form-label fw-semibold text-secondary small"></label>
                    <textarea asp-for="Form.Message" rows="5" class="form-control" 
                              placeholder="Type the announcement message details here..."></textarea>
                    <span asp-validation-for="Form.Message" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text small">This announcement will be visible immediately to residents in the mobile app.</div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                    <i class="bi bi-send-fill"></i>
                    <span>Broadcast Announcement</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Right Column: List of Previous Announcements (Newest First) -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">Announcement History</h5>
            <span class="badge bg-light text-dark border">@Model.Announcements.Count Notices</span>
        </div>

        @if (!Model.Announcements.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-megaphone"></i>
                </div>
                <h5 class="fw-bold">No Announcements Yet</h5>
                <p class="text-muted small mb-0">
                    Use the form on the left to broadcast your first announcement to accommodation residents.
                </p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var notice in Model.Announcements)
                {
                    <div class="card card-custom p-4 shadow-sm border-start border-4 border-primary">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@notice.Title</h5>
                                <div class="small text-muted d-flex align-items-center gap-2">
                                    <span>
                                        <i class="bi bi-clock me-1"></i>
                                        @notice.CreatedAt.ToString("MMMM dd, yyyy HH:mm")
                                    </span>
                                    @if (notice.Creator != null)
                                    {
                                        <span>&bull;</span>
                                        <span>
                                            <i class="bi bi-person me-1"></i>
                                            @notice.Creator.FullName
                                        </span>
                                    }
                                </div>
                            </div>
                            <form asp-action="Delete" asp-route-id="@notice.AnnouncementId" method="post" 
                                  onsubmit="return confirm('Are you sure you want to delete this announcement?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Announcement">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                        <p class="text-secondary mb-0" style="white-space: pre-wrap;">@notice.Message</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

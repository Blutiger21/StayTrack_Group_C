@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom border-danger-subtle shadow-sm text-center p-4">
            <div class="card-body">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-3 mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-x fs-1"></i>
                </div>
                
                <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
                
                <p class="text-secondary mb-3">
                    You do not have permission to access this resource or administrative area.
                </p>

                <div class="alert alert-warning text-start small mb-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-warning flex-shrink-0 mt-1"></i>
                        <div>
                            <strong>Are you a student resident?</strong><br />
                            Student accounts cannot access the staff web portal. Please use the <strong>StayTrack Flutter mobile app</strong> to view your room, upload proof of payment, and track maintenance.
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house me-1"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

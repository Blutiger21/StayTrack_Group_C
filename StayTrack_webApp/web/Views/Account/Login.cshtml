@model StayTrack.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Staff Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom shadow-sm p-3 p-md-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-2 mb-2 shadow-sm" style="width: 48px; height: 48px;">
                        <i class="bi bi-buildings-fill fs-4"></i>
                    </span>
                    <h3 class="fw-bold text-dark mb-1">Staff Sign In</h3>
                    <p class="text-muted small">Enter your registered staff email address to receive a secure one-time passcode (OTP).</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <form asp-action="SendOtp" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="e.g. manager@staytrack.ac.za" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-send-fill"></i>
                        <span>Send Verification Code</span>
                    </button>
                </form>

                <div class="alert alert-light border mt-4 mb-2 small text-secondary">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-shield-lock-fill text-primary mt-1"></i>
                        <div>
                            <strong>Passwordless &amp; Secure</strong><br />
                            A unique 6-digit code will be emailed to your account. No passwords needed.
                        </div>
                    </div>
                </div>

                <div class="mt-3 pt-3 border-top text-center">
                    <span class="text-muted small">
                        Are you a student? Please use the <strong>StayTrack Mobile App</strong>.
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
